{
  "properties": {
    "description": "{{DESCRIPTION}}",
    "activities": [
      {
        "name": "GetWatermark",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "AzurePostgreSqlSource",
            "query": {
              "value": "select to_char(coalesce((select last_value from \"{{WATERMARK_SCHEMA}}\".\"{{WATERMARK_TABLE}}\" where entity = '@{pipeline().parameters.className}'), timestamptz '1900-01-01 00:00:00+00') at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US') as watermark",
              "type": "Expression"
            }
          },
          "datasetSettings": {
            "annotations": [],
            "type": "AzurePostgreSqlTable",
            "schema": [],
            "typeProperties": {},
            "externalReferences": {
              "connection": "{{HUB_CONNECTION_ID}}"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "SetWatermark",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "GetWatermark",
            "dependencyConditions": [
              "Succeeded"
            ]
