          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "queryTimeout": "02:00:00",
            "partitionOption": "None",
            "sqlReaderQuery": {
              "value": "select {{SOURCE_COLUMNS}}, cast(@{variables('loadId')} as bigint) as b_loadid, '@{pipeline().parameters.className}' as b_classname from [@{pipeline().parameters.sourceSchema}].[@{pipeline().parameters.sourceTable}] where [@{pipeline().parameters.watermarkColumn}] > cast('@{variables('watermark')}' as datetime2(6))",
