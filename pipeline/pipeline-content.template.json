      {
        "name": "WaitForBatch",
        "type": "Until",
        "dependsOn": [
          {
            "activity": "HasNewRows",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@contains(createArray('DONE','WARNING','ERROR','CANCELED','SUSPENDED','NO_BATCH'), variables('batchStatus'))",
            "type": "Expression"
          },
          "timeout": "0.01:00:00",
          "activities": [
            {
              "name": "GetBatchStatus",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzurePostgreSqlSource",
                  "query": {
                    "value": "select coalesce((select status from \"{{REPO_SCHEMA}}\".mta_integ_batch where batchid = @{if(empty(variables('batchId')), '-1', variables('batchId'))}), 'NO_BATCH') as status",
                    "type": "Expression"
                  }
                },
                "datasetSettings": {
                  "annotations": [],
                  "type": "AzurePostgreSqlTable",
                  "schema": [],
                  "typeProperties": {},
                  "externalReferences": {
                    "connection": "{{REPO_CONNECTION_ID}}"
                  }
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "SetBatchStatus",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "GetBatchStatus",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "variableName": "batchStatus",
                "value": {
                  "value": "@activity('GetBatchStatus').output.firstRow.status",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "Pause",
              "type": "Wait",
              "dependsOn": [
                {
                  "activity": "SetBatchStatus",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "waitTimeInSeconds": {
                  "value": "@if(equals(variables('batchStatus'), 'NO_BATCH'), 1, 15)",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "BatchSucceeded",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "WaitForBatch",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@contains(createArray('DONE','WARNING','NO_BATCH'), variables('batchStatus'))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "UpdateWatermark",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzurePostgreSqlSource",
                  "query": {
                    "value": "with m as (select max(\"{{WATERMARK_SD_COLUMN}}\") at time zone 'UTC' as v from \"{{SD_SCHEMA}}\".\"{{SD_TABLE}}\" where b_loadid = @{variables('loadId')}), u as (insert into \"{{WATERMARK_SCHEMA}}\".\"{{WATERMARK_TABLE}}\" (entity, last_value, last_load_id) select '@{pipeline().parameters.className}', v, @{variables('loadId')} from m where v is not null on conflict (entity) do update set last_value = greatest(\"{{WATERMARK_SCHEMA}}\".\"{{WATERMARK_TABLE}}\".last_value, excluded.last_value), last_load_id = excluded.last_load_id, updated_at = now() returning last_value) select to_char(coalesce((select last_value from u), (select last_value from \"{{WATERMARK_SCHEMA}}\".\"{{WATERMARK_TABLE}}\" where entity = '@{pipeline().parameters.className}')) at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US') as watermark, (select count(*) from u) as advanced",
                    "type": "Expression"
                  }
                },
                "datasetSettings": {
                  "annotations": [],
                  "type": "AzurePostgreSqlTable",
                  "schema": [],
                  "typeProperties": {},
                  "externalReferences": {
                    "connection": "{{HUB_CONNECTION_ID}}"
                  }
                },
                "firstRowOnly": true
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "FailBatch",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": {
                  "value": "@concat('Integration batch ', variables('batchId'), ' ended in status ', variables('batchStatus'), '; watermark not advanced')",
                  "type": "Expression"
                },
                "errorCode": "SDP_BATCH_FAILED"
              }
            }
          ]
        }
      },
