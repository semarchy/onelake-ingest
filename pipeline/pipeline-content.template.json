              "name": "SetNoBatch",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "CancelEmptyLoad",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
