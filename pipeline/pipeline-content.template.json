                    "type": "Expression"
                  }
                },
                "datasetSettings": {
                  "annotations": [],
                  "type": "AzurePostgreSqlTable",
                  "schema": [],
                  "typeProperties": {},
                  "externalReferences": {
                    "connection": "{{REPO_CONNECTION_ID}}"
                  }
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "SetBatchId",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "SubmitLoad",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "variableName": "batchId",
                "value": {
                  "value": "@string(activity('SubmitLoad').output.firstRow.batch_id)",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "CancelLoad3",
              "type": "Lookup",
              "dependsOn": [
                {
                  "activity": "SubmitLoad",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzurePostgreSqlSource",
                  "query": {
                    "value": "select count(*) as canceled from (select \"{{REPO_SCHEMA}}\".cancel_load(@{variables('loadId')}, '@{pipeline().parameters.sdpUser}')) c",
                    "type": "Expression"
                  }
                },
                "datasetSettings": {
                  "annotations": [],
                  "type": "AzurePostgreSqlTable",
                  "schema": [],
                  "typeProperties": {},
                  "externalReferences": {
                    "connection": "{{REPO_CONNECTION_ID}}"
                  }
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "FailAfterCancel3",
              "type": "Fail",
              "dependsOn": [
                {
                  "activity": "CancelLoad3",
                  "dependencyConditions": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              ],
              "typeProperties": {
                "message": {
                  "value": "SubmitLoad failed; load @{variables('loadId')} was cancelled.",
                  "type": "Expression"
                },
                "errorCode": "SDP_LOAD_CANCELLED"
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "CancelEmptyLoad",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzurePostgreSqlSource",
                  "query": {
                    "value": "select count(*) as canceled from (select \"{{REPO_SCHEMA}}\".cancel_load(@{variables('loadId')}, '@{pipeline().parameters.sdpUser}')) c",
