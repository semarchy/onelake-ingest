          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "AzurePostgreSqlSource",
            "query": {
              "value": "with u as (update \"{{SD_SCHEMA}}\".\"{{SD_TABLE}}\" set {{BLANK_TO_NULL_SET}} where b_loadid = @{variables('loadId')} returning 1) select count(*) as rows_in_load from u",
              "type": "Expression"
            }
          },
          "datasetSettings": {
            "annotations": [],
            "type": "AzurePostgreSqlTable",
            "schema": [],
            "typeProperties": {},
            "externalReferences": {
              "connection": "{{HUB_CONNECTION_ID}}"
            }
