              "value": "select \"{{REPO_SCHEMA}}\".get_new_loadid('@{pipeline().parameters.dataLocation}', '@{pipeline().Pipeline}', 'Fabric load of @{pipeline().parameters.sourceTable} after @{variables('watermark')}', '@{pipeline().parameters.sdpUser}')::bigint as load_id",
              "type": "Expression"
            }
          },
          "datasetSettings": {
            "annotations": [],
            "type": "AzurePostgreSqlTable",
            "schema": [],
            "typeProperties": {},
            "externalReferences": {
              "connection": "{{REPO_CONNECTION_ID}}"
            }
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "SetLoadId",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "GetLoadId",
